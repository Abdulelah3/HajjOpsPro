rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: Check if user is authenticated ───
    function isAuthenticated() {
      return request.auth != null;
    }

    // ─── Audit Logs: Append-only, never delete or update ───
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // سجلات العمليات لا يمكن تعديلها أو حذفها نهائياً
    }

    // ─── Config: Only authenticated users can read/write ───
    match /config/{docId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Standard collections: Full CRUD for authenticated users ───
    match /pilgrims/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /trips/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /locations/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /staff/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /media/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /notifications/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /groupConfigs/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
